---
import type { Place } from "../data/places";
import { sceneFrameUrl } from "../lib/asset-url";

interface Props {
  place: Place;
  scope: string;
  stop: Place["stops"][number];
}

const { place, scope, stop } = Astro.props;

// Native dimensions of the optimized frames (public/scenes/<id>/*.jpg),
// fixed at build time so the <img> can reserve its aspect ratio and never
// shift the layout when a frame swaps.
const FRAME_DIMENSIONS: Record<string, { width: number; height: number }> = {
  nyc: { width: 1000, height: 562 },
  wall: { width: 1000, height: 666 },
  nuclear: { width: 1000, height: 562 },
  rainforest: { width: 1000, height: 562 },
};
const dimensions = FRAME_DIMENSIONS[place.id] ?? { width: 1000, height: 666 };
---

<div
  class="place-visual"
  data-testid="place-visual"
  data-place-id={place.id}
  data-scope={scope}
  data-trajectory={place.trajectory}
>
  <img
    data-testid="place-illustration"
    data-place-id={place.id}
    data-scope={scope}
    class="place-visual-frame"
    src={sceneFrameUrl(place.id, 1)}
    width={dimensions.width}
    height={dimensions.height}
    loading="eager"
    decoding="async"
    alt={`${place.name}: ${stop.label}`}
  />
  <p class="place-visual-label" data-testid="place-visual-label">{stop.label}</p>
  <p class="place-visual-description" data-testid="place-visual-description">{stop.description}</p>
</div>
