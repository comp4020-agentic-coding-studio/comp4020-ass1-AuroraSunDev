---
import { TIMELINE } from "../data/timeline";
import { SLIDER_RESOLUTION } from "../lib/interaction";

interface Props {
  scope: string;
}

const { scope } = Astro.props;
---

<div class="time-slider">
  <input
    type="range"
    data-testid="time-slider"
    data-scope={scope}
    min="0"
    max={SLIDER_RESOLUTION}
    step="1"
    value="0"
    aria-label={`Time since humans disappear (${scope})`}
  />
  <output data-testid="time-readout" data-scope={scope} role="status" aria-live="polite" class="sr-only">
    {TIMELINE[0]?.label}
  </output>
  <ol class="time-slider-ticks" data-scope={scope} aria-hidden="true">
    {TIMELINE.map((stop, index) => (
      <li data-index={index} class={index === 0 ? "is-active" : undefined}>{stop.label}</li>
    ))}
  </ol>
</div>
