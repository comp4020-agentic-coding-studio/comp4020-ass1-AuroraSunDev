---
import type { RainforestVisual } from "../../data/places";

interface Props {
  visual: RainforestVisual;
}

const { visual } = Astro.props;
const canopyOpacity = visual.canopyChange / 100;
const wildlifeOpacity = visual.wildlifeVisibility / 100;
---

<svg
  viewBox="0 0 200 140"
  role="img"
  aria-label="Illustration of an undisturbed tropical rainforest canopy, showing subtle ecological change over time"
  data-testid="place-illustration"
>
  <rect width="200" height="140" fill="#e7f0e3" />
  <path data-part="canopy" d="M0,90 Q30,60 60,85 Q90,55 110,85 Q140,60 170,85 Q190,65 200,85 L200,140 L0,140 Z" fill="#3f7d43" />
  <path data-part="canopy-secondary" d="M0,95 Q30,68 60,90 Q90,62 110,90 Q140,68 170,90 Q190,72 200,90 L200,140 L0,140 Z" fill="#2f6634" opacity={canopyOpacity} />
  <g data-part="wildlife" opacity={wildlifeOpacity}>
    <ellipse cx="70" cy="105" rx="6" ry="3" fill="#2b2f33" />
    <ellipse cx="140" cy="112" rx="6" ry="3" fill="#2b2f33" />
  </g>
</svg>
