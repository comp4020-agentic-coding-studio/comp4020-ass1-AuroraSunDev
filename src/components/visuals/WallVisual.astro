---
import type { WallVisual } from "../../data/places";

interface Props {
  visual: WallVisual;
}

const { visual } = Astro.props;
const vegetationOpacity = visual.vegetation / 100;
const erosionOpacity = visual.erosion / 100;
const gapCount = Math.min(4, Math.round(visual.missingSections / 25));
const gapXs = [24, 74, 114, 156];
---

<svg
  viewBox="0 0 200 80"
  role="img"
  aria-label="Illustration of a Great Wall of China section, showing vegetation, erosion and missing sections over time"
  data-testid="place-illustration"
>
  <rect width="200" height="80" fill="#eee8d5" />
  <path data-part="wall" d="M0,60 L200,60 L200,38 L0,38 Z" fill="#7a6a4f" />
  <g data-part="erosion" opacity={erosionOpacity}>
    <path d="M0,38 L14,46 L28,38 L42,46 L56,38 L70,46 L84,38 L98,46 L112,38 L126,46 L140,38 L154,46 L168,38 L182,46 L196,38 L200,40 L200,38 Z" fill="#eee8d5" />
  </g>
  <g data-part="vegetation" opacity={vegetationOpacity}>
    <circle cx="20" cy="40" r="3" fill="#3f7d43" />
    <circle cx="60" cy="42" r="3" fill="#3f7d43" />
    <circle cx="100" cy="40" r="3" fill="#3f7d43" />
    <circle cx="140" cy="42" r="3" fill="#3f7d43" />
    <circle cx="180" cy="40" r="3" fill="#3f7d43" />
  </g>
  <g data-part="gaps">
    {gapXs.map((x, i) => (
      <rect data-part="gap" x={x} y="38" width="10" height="22" fill="#eee8d5" opacity={i < gapCount ? 1 : 0} />
    ))}
  </g>
</svg>
