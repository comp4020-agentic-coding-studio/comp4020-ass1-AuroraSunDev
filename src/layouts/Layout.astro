---
import "../styles/global.css";
import { assetUrl } from "../lib/asset-url";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    {/*
      Kept as PNG, never converted: the drawing is line art on a transparent
      background, and flattening it to JPEG would put it on an opaque white
      square. Two sizes because a browser downscaling 512px to a 16px tab
      renders the outline to mush; the 32 is what actually gets used there.
      Paths go through assetUrl or they 404 under the Pages base path.
    */}
    <link rel="icon" type="image/png" sizes="32x32" href={assetUrl("favicon-32.png")} />
    <link rel="icon" type="image/png" sizes="512x512" href={assetUrl("favicon.png")} />
    <link rel="apple-touch-icon" href={assetUrl("apple-touch-icon.png")} />

    {/* Tints mobile browser chrome to match the header, so the frame around
        the page belongs to it rather than to the browser. */}
    <meta name="theme-color" content="#0a6885" />
  </head>
  <body>
    <slot />
  </body>
</html>
