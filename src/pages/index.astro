---
import Layout from "../layouts/Layout.astro";
import { assetUrl } from "../lib/asset-url";
import "../styles/intro.css";
---

<Layout title="When Humans Vanish">
  <h1 class="sr-only">When Humans Vanish</h1>

  <div class="intro" data-testid="intro-stage">
    <div class="intro-frame">
      <img
        class="intro-crowd"
        src={assetUrl("intro/crowd.jpg")}
        width="1376"
        height="768"
        fetchpriority="high"
        alt="A dense city crowd filling a street from edge to edge, hundreds of people walking, one woman near the centre looking straight ahead"
      />
      {/*
        Two elements, because the button is a physical object: the <button> is
        the housing that stays put, and the span is the cap that travels down
        into it when pressed. One element could only move as a whole, which
        reads as the whole control sliding rather than a key being pushed.
      */}
      <button
        type="button"
        class="intro-vanish"
        data-testid="vanish-trigger"
        aria-describedby="intro-vanish-hint"
      >
        <span class="intro-vanish-cap">Push</span>
      </button>
      <span id="intro-vanish-hint" class="sr-only">
        Starts the sequence that makes everyone here disappear
      </span>
    </div>

    {/*
      The burst is drawn, not photographed. It used to be a PNG of a star, and
      a bitmap can only ever be the shape it was drawn at — blown up to fill a
      screen its outline stayed hard and its black spikes sat in frame long
      after the middle had gone white. Two gradient layers instead: a core that
      goes solid white at the centre and thins outwards, and a fan of rays that
      does the same, so every edge fades on its own rather than ending.
    */}
    <div class="intro-burst" data-testid="intro-boom" aria-hidden="true">
      <div class="intro-burst-rays"></div>
      <div class="intro-burst-core"></div>
    </div>
    <div class="intro-whiteout" aria-hidden="true"></div>
    <p class="intro-line" data-testid="intro-line">When humans vanish in a second</p>
  </div>

  <nav aria-label="Skip the intro" class="intro-nav">
    <a href="./explainer.html" data-testid="intro-skip">Skip to the explainer</a>
  </nav>

  <script src="../scripts/intro.ts"></script>
</Layout>
