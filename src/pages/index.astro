---
import Layout from "../layouts/Layout.astro";
import { assetUrl } from "../lib/asset-url";
import "../styles/intro.css";
---

<Layout title="When Humans Vanish">
  <h1 class="sr-only">When Humans Vanish</h1>

  <div class="intro" data-testid="intro-stage">
    <div class="intro-frame">
      <img
        class="intro-crowd"
        src={assetUrl("intro/crowd.jpg")}
        width="1672"
        height="941"
        fetchpriority="high"
        alt="A hand-drawn crowd packed edge to edge with hundreds of small smiling figures, one larger figure standing at the centre"
      />
      <button type="button" class="intro-vanish" data-testid="vanish-trigger">vanish</button>
    </div>

    <img
      class="intro-boom"
      data-testid="intro-boom"
      src={assetUrl("intro/boom.png")}
      width="1200"
      height="800"
      alt=""
      aria-hidden="true"
    />
    <div class="intro-whiteout" aria-hidden="true"></div>
    <p class="intro-line" data-testid="intro-line">When humans vanish in a second</p>
  </div>

  <nav aria-label="Skip the intro" class="intro-nav">
    <a href="./explainer.html" data-testid="intro-skip">Skip to the explainer</a>
  </nav>

  <script src="../scripts/intro.ts"></script>
</Layout>
