---
import Layout from "../layouts/Layout.astro";
import { assetUrl } from "../lib/asset-url";
import "../styles/intro.css";
---

<Layout title="When Humans Vanish">
  <h1 class="sr-only">When Humans Vanish</h1>

  <div class="intro" data-testid="intro-stage">
    <div class="intro-frame">
      <img
        class="intro-crowd"
        src={assetUrl("intro/crowd.jpg")}
        width="1376"
        height="768"
        fetchpriority="high"
        alt="A dense city crowd filling a street from edge to edge, hundreds of people walking, one woman near the centre looking straight ahead"
      />
      {/*
        One line in one span. The photo is busy enough that two stacked words
        read as noise in it, where a single pill reads as a control.
      */}
      <button
        type="button"
        class="intro-vanish"
        data-testid="vanish-trigger"
        aria-describedby="intro-vanish-hint"
      >
        <span>Push me</span>
      </button>
      <span id="intro-vanish-hint" class="sr-only">
        Starts the sequence that makes everyone here disappear
      </span>
    </div>

    <img
      class="intro-boom"
      data-testid="intro-boom"
      src={assetUrl("intro/boom.png")}
      width="1200"
      height="800"
      alt=""
      aria-hidden="true"
    />
    <div class="intro-whiteout" aria-hidden="true"></div>
    <p class="intro-line" data-testid="intro-line">When humans vanish in a second</p>
  </div>

  <nav aria-label="Skip the intro" class="intro-nav">
    <a href="./explainer.html" data-testid="intro-skip">Skip to the explainer</a>
  </nav>

  <script src="../scripts/intro.ts"></script>
</Layout>
